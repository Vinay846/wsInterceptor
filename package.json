{
  "name": "@pp/wsinterceptor",
  "version": "0.0.0",
  "description": "WebSocket interceptor and proxy tool with React UI",
  "main": "src/index.tsx",
  "bin": "server.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "build:executables": "npm run build && npm run pkg:build && npm run post:pkg",
    "pkg:build": "pkg . --compress GZip",
    "pkg:build-win": "pkg . --targets node18-win-x64 --compress GZip && npm run post:pkg",
    "pkg:build-linux": "pkg . --targets node18-linux-x64 --compress GZip && npm run post:pkg",
    "pkg:build-macos": "pkg . --targets node18-macos-x64 --compress GZip && npm run post:pkg",
    "post:pkg": "node post-pkg.js"
  },
  "author": "",
  "license": "ISC",
  "browserslist": [
    ">0.1%, defaults, last 4 versions, not dead, unreleased versions"
  ],
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.0",
    "pkg": "^5.8.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.525.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.4",
    "ws": "^8.18.0"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "shared-constants.js"
    ],
    "assets": [
      "dist/**/*",
      "data.json",
      "shortcuts.json",
      "app.manifest"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "outputPath": "build",
    "output": "build/wsinterceptor"
  }
}
